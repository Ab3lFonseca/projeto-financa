{
  "name": "@app/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API REST (Fastify + Zod + Prisma)",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "node dist/server.js",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:demo": "tsx --env-file-if-exists=../../.env scripts/seed-demo.ts",
    "pluggy:webhook": "tsx --env-file-if-exists=../../.env scripts/pluggy-webhook.ts"
  },
  "dependencies": {
    "@app/database": "workspace:*",
    "@app/shared": "workspace:*",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.9.1",
    "dotenv": "^18.0.5",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "jose": "^6.2.12",
    "openapi-types": "^12.1.3",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@app/dev-db": "workspace:*",
    "@types/node": "^24.0.0",
    "pino-pretty": "^13.1.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
