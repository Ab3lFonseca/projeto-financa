// ============================================================================
// Modelo de dados — fonte de verdade da estrutura (tabelas, colunas, FKs, índices).
//
// O que o Prisma NÃO expressa vive em SQL manual:
//   prisma/migrations/20261004000100_constraints_and_rls/migration.sql
//   (CHECK constraints, triggers de updated_at, FKs deferidas, RLS, papéis/grants)
// Racional completo: docs/database.md
//
// Convenções
//   - Tabelas/colunas em snake_case (@@map/@map); modelos/campos em camelCase.
//   - Dinheiro SEMPRE em centavos (BigInt). Nunca float.
//   - Datas "de calendário" (occurred_on, due_date...) são DATE, sem fuso.
//     Instantes (created_at...) são timestamptz.
//   - Toda tabela de usuário tem user_id. Relações entre tabelas de usuário usam
//     FK COMPOSTA (user_id, id): o banco impede referenciar dados de outro usuário.
//   - Soft delete (deleted_at) só onde o histórico importa.
// ============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────────── Enums ─────────────────────────────────────

enum UserRole {
  USER
  ADMIN

  @@map("user_role")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETING

  @@map("user_status")
}

enum ThemePreference {
  SYSTEM
  LIGHT
  DARK

  @@map("theme_preference")
}

enum Plan {
  FREE
  PREMIUM

  @@map("plan")
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  EXPIRED

  @@map("subscription_status")
}

enum SubscriptionStore {
  APPLE
  GOOGLE
  WEB
  MANUAL

  @@map("subscription_store")
}

enum ConsentType {
  TERMS
  PRIVACY
  OPEN_FINANCE
  MARKETING

  @@map("consent_type")
}

enum AccountType {
  CHECKING
  SAVINGS
  WALLET
  DIGITAL
  INVESTMENT

  @@map("account_type")
}

enum DataOrigin {
  MANUAL
  OPEN_FINANCE

  @@map("data_origin")
}

enum CardBrand {
  VISA
  MASTERCARD
  ELO
  AMEX
  HIPERCARD
  OTHER

  @@map("card_brand")
}

enum InvoiceStatus {
  OPEN
  CLOSED
  PAID

  @@map("invoice_status")
}

enum CategoryType {
  EXPENSE
  INCOME

  @@map("category_type")
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER

  @@map("transaction_type")
}

enum TransactionStatus {
  PENDING
  POSTED

  @@map("transaction_status")
}

enum PaymentMethod {
  PIX
  DEBIT
  CREDIT
  CASH
  BOLETO
  TED_DOC
  OTHER

  @@map("payment_method")
}

enum TransferSide {
  OUT
  IN

  @@map("transfer_side")
}

enum RecurrenceFrequency {
  WEEKLY
  MONTHLY
  YEARLY

  @@map("recurrence_frequency")
}

enum GoalKind {
  EMERGENCY_FUND
  TRAVEL
  VEHICLE
  HOME
  EDUCATION
  RETIREMENT
  EVENT
  OTHER

  @@map("goal_kind")
}

enum GoalStatus {
  ACTIVE
  ACHIEVED
  ARCHIVED

  @@map("goal_status")
}

enum OpenFinanceProvider {
  PLUGGY

  @@map("open_finance_provider")
}

enum ConnectionStatus {
  CONNECTING
  ACTIVE
  OUTDATED
  ERROR
  REVOKED

  @@map("connection_status")
}

enum BankTransactionDirection {
  CREDIT
  DEBIT

  @@map("bank_transaction_direction")
}

enum BankTransactionStatus {
  NEW
  MATCHED
  IMPORTED
  IGNORED

  @@map("bank_transaction_status")
}

enum NotificationType {
  BILL_DUE
  INVOICE_DUE
  BUDGET_NEAR_LIMIT
  BUDGET_EXCEEDED
  GOAL_PROGRESS
  GOAL_ACHIEVED
  TRANSACTION_SYNCED
  SYNC_FAILED
  SYSTEM

  @@map("notification_type")
}

enum PushPlatform {
  IOS
  ANDROID

  @@map("push_platform")
}

enum PrivacyRequestType {
  EXPORT
  DELETE

  @@map("privacy_request_type")
}

enum PrivacyRequestStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED

  @@map("privacy_request_status")
}

// ───────────────────────── Identidade e conta do usuário ─────────────────────

/// Espelho local do usuário. `id` = id do Supabase Auth (auth.users.id).
/// Senhas NÃO existem aqui: ficam exclusivamente no provedor de autenticação.
model User {
  id         String     @id @db.Uuid
  email      String     @unique // sempre minúsculo (CHECK na migration SQL)
  role       UserRole   @default(USER)
  status     UserStatus @default(ACTIVE)
  lastSeenAt DateTime?  @map("last_seen_at") @db.Timestamptz(6)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt  DateTime?  @map("deleted_at") @db.Timestamptz(6)

  profile                 Profile?
  subscription            Subscription?
  consents                Consent[]
  accounts                Account[]
  creditCards             CreditCard[]
  invoices                Invoice[]
  invoicePayments         InvoicePayment[]
  categories              Category[]
  transactions            Transaction[]
  transfers               Transfer[]
  recurringRules          RecurringRule[]
  budgets                 Budget[]
  goals                   Goal[]
  goalContributions       GoalContribution[]
  bankConnections         BankConnection[]
  bankConnectionAccounts  BankConnectionAccount[]
  bankTransactions        BankTransaction[]
  bankInvestments         BankInvestment[]
  bankInvestmentSnapshots BankInvestmentSnapshot[]
  notifications           Notification[]
  pushTokens              PushToken[]
  privacyRequests         PrivacyRequest[]
  idempotencyKeys         IdempotencyKey[]

  @@index([status])
  @@map("users")
}

model Profile {
  userId                String          @id @map("user_id") @db.Uuid
  displayName           String?         @map("display_name") @db.VarChar(100)
  locale                String          @default("pt-BR") @db.VarChar(10)
  timezone              String          @default("America/Sao_Paulo") @db.VarChar(64)
  currency              String          @default("BRL") @db.Char(3)
  theme                 ThemePreference @default(SYSTEM)
  /// Tema escolhido no app (preset + cores personalizadas), validado por Zod na API. Nulo = vale `theme`.
  appearance            Json?           @map("appearance")
  /// Preferências de notificação (validadas por Zod na API).
  notificationPrefs     Json            @default("{}") @map("notification_prefs")
  onboardingCompletedAt DateTime?       @map("onboarding_completed_at") @db.Timestamptz(6)
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

/// Entitlements (plano). Ausência de linha = FREE. Escrita só pelo servidor/webhooks.
model Subscription {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String             @unique @map("user_id") @db.Uuid
  plan             Plan               @default(FREE)
  status           SubscriptionStatus @default(ACTIVE)
  store            SubscriptionStore  @default(MANUAL)
  externalId       String?            @map("external_id")
  /// Cliente no provedor de pagamento (abre o portal de assinatura). Nulo em cortesia e no teste grátis.
  providerCustomerId String?          @map("provider_customer_id") @db.VarChar(128)
  currentPeriodEnd DateTime?          @map("current_period_end") @db.Timestamptz(6)
  /// Fim do teste grátis. Nulo = o servidor calcula (cadastro + TRIAL_DAYS); preenchido = prorrogação ou encurtamento pelo suporte.
  trialEndsAt      DateTime?          @map("trial_ends_at") @db.Timestamptz(6)
  /// A assinatura foi cancelada e termina no fim do período já pago.
  cancelAtPeriodEnd Boolean           @default(false) @map("cancel_at_period_end")
  /// Tem o adicional "Rendimentos" (CDI/CDB, porquinhos e investimentos acompanhados todo dia), cobrado por cima do plano básico.
  /// No teste grátis e na conta de administrador o recurso vale sem este campo. Em cortesia, quem concede escolhe.
  investmentsAddon Boolean            @default(false) @map("investments_addon")
  canceledAt       DateTime?          @map("canceled_at") @db.Timestamptz(6)
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([store, externalId])
  @@map("subscriptions")
}

/// Webhooks do provedor de pagamento já recebidos (idempotência: o mesmo evento chega mais de uma vez). Sem payload: ele traz e-mail e
/// dados do pagamento, e o servidor sempre relê o estado atual na API do provedor. Sem acesso para `app_user` (só o servidor).
model BillingEvent {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider    String    @db.VarChar(20)
  eventId     String    @map("event_id") @db.VarChar(128)
  eventType   String    @map("event_type") @db.VarChar(80)
  receivedAt  DateTime  @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(6)

  @@unique([provider, eventId])
  @@index([receivedAt])
  @@map("billing_events")
}

/// Log de consentimentos (LGPD). Uma linha por aceite; revogação preenche revoked_at.
model Consent {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  type      ConsentType
  /// Versão do documento aceito (ex.: "2026-10-01").
  version   String      @db.VarChar(32)
  grantedAt DateTime    @default(now()) @map("granted_at") @db.Timestamptz(6)
  revokedAt DateTime?   @map("revoked_at") @db.Timestamptz(6)
  /// Hash do IP (nunca o IP em claro).
  ipHash    String?     @map("ip_hash") @db.VarChar(64)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, grantedAt])
  @@map("consents")
}

// ─────────────────────────── Catálogo global ─────────────────────────────────

/// Catálogo de bancos (global, somente leitura para usuários).
model Bank {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  compeCode String?  @unique @map("compe_code") @db.VarChar(3)
  ispb      String?  @unique @db.VarChar(8)
  name      String   @db.VarChar(120)
  shortName String?  @map("short_name") @db.VarChar(40)
  logoUrl   String?  @map("logo_url")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  accounts        Account[]
  creditCards     CreditCard[]
  bankConnections BankConnection[]

  @@map("banks")
}

// ──────────────────────────── Contas e cartões ───────────────────────────────

/// Saldo NÃO é coluna: saldo = opening_balance + Σ lançamentos (ver docs/database.md).
model Account {
  id                  String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String      @map("user_id") @db.Uuid
  bankId              String?     @map("bank_id") @db.Uuid
  name                String      @db.VarChar(80)
  type                AccountType
  openingBalanceCents BigInt      @default(0) @map("opening_balance_cents")
  currency            String      @default("BRL") @db.Char(3)
  color               String?     @db.VarChar(7)
  icon                String?     @db.VarChar(40)
  /// Se entra no "Saldo total" do dashboard (ex.: investimentos podem ficar de fora).
  includeInTotal      Boolean     @default(true) @map("include_in_total")
  source              DataOrigin  @default(MANUAL)
  archivedAt          DateTime?   @map("archived_at") @db.Timestamptz(6)
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime?   @map("deleted_at") @db.Timestamptz(6)

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  bank Bank? @relation(fields: [bankId], references: [id], onDelete: SetNull)

  transactions    Transaction[]
  recurringRules  RecurringRule[]
  transfersOut    Transfer[]              @relation("TransferFromAccount")
  transfersIn     Transfer[]              @relation("TransferToAccount")
  invoicePayments InvoicePayment[]
  payingForCards  CreditCard[]            @relation("CardPayAccount")
  bankLinks       BankConnectionAccount[]

  @@unique([userId, id])
  @@index([userId, deletedAt])
  @@index([bankId])
  @@map("accounts")
}

model CreditCard {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String     @map("user_id") @db.Uuid
  bankId       String?    @map("bank_id") @db.Uuid
  name         String     @db.VarChar(80)
  brand        CardBrand  @default(OTHER)
  last4        String?    @db.Char(4)
  limitCents   BigInt     @map("limit_cents")
  /// Dia de fechamento da fatura (1–31; meses curtos usam o último dia).
  closingDay   Int        @map("closing_day") @db.SmallInt
  /// Dia de vencimento (1–31; meses curtos usam o último dia).
  dueDay       Int        @map("due_day") @db.SmallInt
  /// Conta usada por padrão para pagar a fatura.
  payAccountId String?    @map("pay_account_id") @db.Uuid
  color        String?    @db.VarChar(7)
  icon         String?    @db.VarChar(40)
  source       DataOrigin @default(MANUAL)
  archivedAt   DateTime?  @map("archived_at") @db.Timestamptz(6)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?  @map("deleted_at") @db.Timestamptz(6)

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bank       Bank?    @relation(fields: [bankId], references: [id], onDelete: SetNull)
  payAccount Account? @relation("CardPayAccount", fields: [userId, payAccountId], references: [userId, id], onDelete: NoAction)

  invoices       Invoice[]
  transactions   Transaction[]
  recurringRules RecurringRule[]
  bankLinks      BankConnectionAccount[]

  @@unique([userId, id])
  @@index([userId, deletedAt])
  @@index([bankId])
  @@map("credit_cards")
}

/// Fatura de cartão. Criada sob demanda quando a primeira compra cai no ciclo.
/// Total da fatura = Σ lançamentos com invoice_id (calculado, não armazenado).
model Invoice {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  cardId         String        @map("card_id") @db.Uuid
  /// Mês de referência (sempre dia 1).
  referenceMonth DateTime      @map("reference_month") @db.Date
  closingDate    DateTime      @map("closing_date") @db.Date
  dueDate        DateTime      @map("due_date") @db.Date
  status         InvoiceStatus @default(OPEN)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  card CreditCard @relation(fields: [userId, cardId], references: [userId, id], onDelete: NoAction)

  transactions Transaction[]
  payments     InvoicePayment[]

  @@unique([cardId, referenceMonth])
  @@unique([userId, id])
  @@index([userId, dueDate])
  @@map("invoices")
}

/// Pagamento de fatura: debita a conta, mas NÃO conta como despesa
/// (a despesa já foi contada na compra). Evita dupla contagem.
model InvoicePayment {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  invoiceId   String   @map("invoice_id") @db.Uuid
  accountId   String   @map("account_id") @db.Uuid
  amountCents BigInt   @map("amount_cents")
  paidOn      DateTime @map("paid_on") @db.Date
  notes       String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [userId, invoiceId], references: [userId, id], onDelete: NoAction)
  account Account @relation(fields: [userId, accountId], references: [userId, id], onDelete: NoAction)

  @@index([userId, invoiceId])
  @@index([userId, accountId, paidOn])
  @@map("invoice_payments")
}

// ─────────────────────────────── Categorias ──────────────────────────────────

/// Categorias padrão são COPIADAS para cada usuário no cadastro (system_key marca
/// a origem), assim o usuário pode editar/excluir livremente.
model Category {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  type       CategoryType
  name       String       @db.VarChar(60)
  /// Nome do ícone (conjunto Lucide), ex.: "utensils".
  icon       String       @default("tag") @db.VarChar(40)
  /// Cor em hex, ex.: "#F97316".
  color      String       @default("#94A3B8") @db.VarChar(7)
  parentId   String?      @map("parent_id") @db.Uuid
  systemKey  String?      @map("system_key") @db.VarChar(40)
  sortOrder  Int          @default(0) @map("sort_order")
  archivedAt DateTime?    @map("archived_at") @db.Timestamptz(6)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt  DateTime?    @map("deleted_at") @db.Timestamptz(6)

  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent Category? @relation("CategoryTree", fields: [userId, parentId], references: [userId, id], onDelete: NoAction)

  children       Category[]      @relation("CategoryTree")
  transactions   Transaction[]
  recurringRules RecurringRule[]
  budgets        Budget[]

  @@unique([userId, id])
  @@unique([userId, systemKey])
  @@index([userId, type, deletedAt])
  @@map("categories")
}

// ────────────────────────────── Lançamentos ──────────────────────────────────

/// Regras de origem do lançamento (CHECKs na migration SQL):
///   - exatamente UM entre account_id e card_id;
///   - card_id <=> payment_method = CREDIT;
///   - TRANSFER => transfer_id + transfer_side (duas "pernas": OUT e IN), sem categoria.
/// Parcelas: uma linha por parcela, ligadas por installment_group_id; occurred_on é a
/// data em que a parcela é cobrada (compra + i meses).
model Transaction {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String            @map("user_id") @db.Uuid
  type               TransactionType
  status             TransactionStatus @default(POSTED)
  description        String            @db.VarChar(200)
  amountCents        BigInt            @map("amount_cents")
  occurredOn         DateTime          @map("occurred_on") @db.Date
  accountId          String?           @map("account_id") @db.Uuid
  cardId             String?           @map("card_id") @db.Uuid
  categoryId         String?           @map("category_id") @db.Uuid
  paymentMethod      PaymentMethod     @default(OTHER) @map("payment_method")
  invoiceId          String?           @map("invoice_id") @db.Uuid
  installmentGroupId String?           @map("installment_group_id") @db.Uuid
  installmentNo      Int?              @map("installment_no") @db.SmallInt
  installmentTotal   Int?              @map("installment_total") @db.SmallInt
  transferId         String?           @map("transfer_id") @db.Uuid
  transferSide       TransferSide?     @map("transfer_side")
  recurrenceId       String?           @map("recurrence_id") @db.Uuid
  bankTransactionId  String?           @map("bank_transaction_id") @db.Uuid
  notes              String?           @db.VarChar(1000)
  /// Bloqueio otimista (sync offline / edição concorrente).
  version            Int               @default(1)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime?         @map("deleted_at") @db.Timestamptz(6)

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  account         Account?         @relation(fields: [userId, accountId], references: [userId, id], onDelete: NoAction)
  card            CreditCard?      @relation(fields: [userId, cardId], references: [userId, id], onDelete: NoAction)
  category        Category?        @relation(fields: [userId, categoryId], references: [userId, id], onDelete: NoAction)
  invoice         Invoice?         @relation(fields: [userId, invoiceId], references: [userId, id], onDelete: NoAction)
  transfer        Transfer?        @relation(fields: [userId, transferId], references: [userId, id], onDelete: NoAction)
  recurrence      RecurringRule?   @relation(fields: [userId, recurrenceId], references: [userId, id], onDelete: NoAction)
  bankTransaction BankTransaction? @relation(fields: [userId, bankTransactionId], references: [userId, id], onDelete: NoAction)

  goalContributions GoalContribution[]

  @@unique([userId, id])
  // Um lançamento por transação bancária importada.
  @@unique([userId, bankTransactionId])
  // Geração de recorrência idempotente (e não regera ocorrência excluída).
  @@unique([recurrenceId, occurredOn])
  // No máximo uma perna OUT e uma IN por transferência.
  @@unique([transferId, transferSide])
  // Paginação por cursor da listagem principal.
  @@index([userId, occurredOn, id])
  @@index([userId, accountId, occurredOn])
  @@index([userId, cardId, occurredOn])
  @@index([userId, categoryId, occurredOn])
  @@index([userId, type, occurredOn])
  // Sync incremental ("o que mudou desde X").
  @@index([userId, updatedAt])
  @@index([invoiceId])
  @@index([installmentGroupId])
  @@map("transactions")
}

/// Cabeçalho de uma transferência entre contas. Os efeitos no saldo vêm das duas
/// pernas em `transactions` (type = TRANSFER). Não entra em receitas/despesas.
model Transfer {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  fromAccountId String    @map("from_account_id") @db.Uuid
  toAccountId   String    @map("to_account_id") @db.Uuid
  amountCents   BigInt    @map("amount_cents")
  occurredOn    DateTime  @map("occurred_on") @db.Date
  notes         String?   @db.VarChar(500)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)

  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromAccount Account @relation("TransferFromAccount", fields: [userId, fromAccountId], references: [userId, id], onDelete: NoAction)
  toAccount   Account @relation("TransferToAccount", fields: [userId, toAccountId], references: [userId, id], onDelete: NoAction)

  legs Transaction[]

  @@unique([userId, id])
  @@index([userId, occurredOn])
  @@map("transfers")
}

/// Modelo de lançamento recorrente. O job (pg-boss) gera as ocorrências
/// até hoje a partir de next_run_on, de forma idempotente.
model RecurringRule {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String              @map("user_id") @db.Uuid
  type          TransactionType // INCOME ou EXPENSE (TRANSFER barrado por CHECK)
  description   String              @db.VarChar(200)
  amountCents   BigInt              @map("amount_cents")
  accountId     String?             @map("account_id") @db.Uuid
  cardId        String?             @map("card_id") @db.Uuid
  categoryId    String?             @map("category_id") @db.Uuid
  paymentMethod PaymentMethod       @default(OTHER) @map("payment_method")
  frequency     RecurrenceFrequency
  /// A cada N períodos (1 = todo mês/semana/ano).
  intervalCount Int                 @default(1) @map("interval_count") @db.SmallInt
  /// Para MONTHLY/YEARLY: dia do mês (31 em mês curto = último dia).
  dayOfMonth    Int?                @map("day_of_month") @db.SmallInt
  startDate     DateTime            @map("start_date") @db.Date
  endDate       DateTime?           @map("end_date") @db.Date
  nextRunOn     DateTime            @map("next_run_on") @db.Date
  lastRunOn     DateTime?           @map("last_run_on") @db.Date
  active        Boolean             @default(true)
  notes         String?             @db.VarChar(1000)
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?           @map("deleted_at") @db.Timestamptz(6)

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  account  Account?    @relation(fields: [userId, accountId], references: [userId, id], onDelete: NoAction)
  card     CreditCard? @relation(fields: [userId, cardId], references: [userId, id], onDelete: NoAction)
  category Category?   @relation(fields: [userId, categoryId], references: [userId, id], onDelete: NoAction)

  transactions Transaction[]

  @@unique([userId, id])
  // Varredura do job: regras ativas vencidas.
  @@index([active, nextRunOn])
  @@index([userId, active])
  @@map("recurring_rules")
}

// ─────────────────────────── Orçamentos e metas ──────────────────────────────

/// Orçamento mensal por categoria de despesa. Uma linha por (categoria, mês);
/// "copiar do mês anterior" é uma operação da API. Exclusão é definitiva (sem soft delete).
model Budget {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  categoryId  String   @map("category_id") @db.Uuid
  /// Primeiro dia do mês.
  month       DateTime @db.Date
  amountCents BigInt   @map("amount_cents")
  /// Percentual de uso a partir do qual alertar (1–100).
  alertPct    Int      @default(80) @map("alert_pct") @db.SmallInt
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [userId, categoryId], references: [userId, id], onDelete: NoAction)

  @@unique([userId, categoryId, month])
  @@index([userId, month])
  @@map("budgets")
}

/// Meta financeira. Valor atual = initial_cents + Σ aportes (calculado).
model Goal {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String     @map("user_id") @db.Uuid
  name         String     @db.VarChar(80)
  kind         GoalKind   @default(OTHER)
  targetCents  BigInt     @map("target_cents")
  initialCents BigInt     @default(0) @map("initial_cents")
  deadline     DateTime?  @db.Date
  status       GoalStatus @default(ACTIVE)
  icon         String?    @db.VarChar(40)
  color        String?    @db.VarChar(7)
  achievedAt   DateTime?  @map("achieved_at") @db.Timestamptz(6)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?  @map("deleted_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  contributions GoalContribution[]

  @@unique([userId, id])
  @@index([userId, status])
  @@map("goals")
}

/// Aporte (positivo) ou resgate (negativo) em uma meta.
model GoalContribution {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  goalId        String   @map("goal_id") @db.Uuid
  amountCents   BigInt   @map("amount_cents")
  occurredOn    DateTime @map("occurred_on") @db.Date
  notes         String?  @db.VarChar(500)
  /// Lançamento associado, quando o aporte também sai de uma conta.
  transactionId String?  @map("transaction_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal        Goal         @relation(fields: [userId, goalId], references: [userId, id], onDelete: NoAction)
  transaction Transaction? @relation(fields: [userId, transactionId], references: [userId, id], onDelete: NoAction)

  @@index([userId, goalId, occurredOn])
  @@map("goal_contributions")
}

// ───────────────────── Open Finance (módulo desacoplado) ─────────────────────
// Nenhuma coluna aqui guarda credencial bancária. A autenticação ocorre no fluxo
// oficial do provedor/banco; guardamos só o identificador da conexão e o status.

model BankConnection {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String              @map("user_id") @db.Uuid
  provider         OpenFinanceProvider
  /// Id da conexão ("item") no provedor.
  providerItemId   String              @map("provider_item_id") @db.VarChar(128)
  institutionName  String              @map("institution_name") @db.VarChar(120)
  bankId           String?             @map("bank_id") @db.Uuid
  status           ConnectionStatus    @default(CONNECTING)
  consentGrantedAt DateTime?           @map("consent_granted_at") @db.Timestamptz(6)
  /// Nulo = sem prazo definido (o limite de 12 meses foi removido pelo BCB; confirmar com o provedor).
  consentExpiresAt DateTime?           @map("consent_expires_at") @db.Timestamptz(6)
  lastSyncAt       DateTime?           @map("last_sync_at") @db.Timestamptz(6)
  /// Apenas código de erro, nunca mensagem com dados do usuário.
  lastErrorCode    String?             @map("last_error_code") @db.VarChar(64)
  /// true = a sincronização cria as contas/cartões que faltam e importa as transações sozinha (sem revisão manual).
  autoImport       Boolean             @default(true) @map("auto_import")
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  revokedAt        DateTime?           @map("revoked_at") @db.Timestamptz(6)

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  bank Bank? @relation(fields: [bankId], references: [id], onDelete: SetNull)

  accounts     BankConnectionAccount[]
  transactions BankTransaction[]
  investments  BankInvestment[]

  @@unique([provider, providerItemId])
  @@unique([userId, id])
  @@index([userId, status])
  @@map("bank_connections")
}

/// Liga uma conta/cartão do provedor a uma conta/cartão local.
model BankConnectionAccount {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  connectionId         String    @map("connection_id") @db.Uuid
  providerAccountId    String    @map("provider_account_id") @db.VarChar(128)
  displayName          String?   @map("display_name") @db.VarChar(120)
  /// "BANK" (conta) ou "CREDIT" (cartão), como informado pelo provedor. Define o sinal das transações.
  kind                 String    @default("BANK") @db.VarChar(10)
  /// Último saldo/fatura informado pelo provedor (apenas informativo; o saldo do app é calculado).
  /// Em cartão (kind = CREDIT): valor da fatura em aberto.
  balanceCents         BigInt?   @map("balance_cents")
  /// Dados do cartão informados pelo banco (só kind = CREDIT).
  creditLimitCents     BigInt?   @map("credit_limit_cents")
  availableCreditCents BigInt?   @map("available_credit_cents")
  minimumPaymentCents  BigInt?   @map("minimum_payment_cents")
  billCloseDate        DateTime? @map("bill_close_date") @db.Date
  billDueDate          DateTime? @map("bill_due_date") @db.Date
  cardBrand            String?   @map("card_brand") @db.VarChar(30)
  /// Quando o app leu estes dados do provedor pela última vez.
  providerDataAt       DateTime? @map("provider_data_at") @db.Timestamptz(6)
  accountId            String?   @map("account_id") @db.Uuid
  cardId               String?   @map("card_id") @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection BankConnection @relation(fields: [userId, connectionId], references: [userId, id], onDelete: NoAction)
  account    Account?       @relation(fields: [userId, accountId], references: [userId, id], onDelete: NoAction)
  card       CreditCard?    @relation(fields: [userId, cardId], references: [userId, id], onDelete: NoAction)

  @@unique([connectionId, providerAccountId])
  @@map("bank_connection_accounts")
}

/// Transação bruta vinda do provedor. Fica separada de `transactions` para permitir
/// revisão/conciliação antes de virar lançamento. Upsert idempotente por (conexão, id no provedor).
model BankTransaction {
  id                String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String                   @map("user_id") @db.Uuid
  connectionId      String                   @map("connection_id") @db.Uuid
  providerAccountId String                   @map("provider_account_id") @db.VarChar(128)
  providerTxId      String                   @map("provider_tx_id") @db.VarChar(128)
  amountCents       BigInt                   @map("amount_cents")
  direction         BankTransactionDirection
  postedOn          DateTime                 @map("posted_on") @db.Date
  descriptionRaw    String                   @map("description_raw") @db.VarChar(500)
  status            BankTransactionStatus    @default(NEW)
  createdAt         DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)

  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection BankConnection @relation(fields: [userId, connectionId], references: [userId, id], onDelete: NoAction)

  /// Lançamento criado/conciliado a partir desta transação.
  transaction Transaction?

  @@unique([connectionId, providerTxId])
  @@unique([userId, id])
  @@index([userId, status, postedOn])
  @@map("bank_transactions")
}

/// Investimento vindo do Open Finance (CDB, caixinhas/cofrinhos/porquinhos, LCI/LCA, fundos, ações...).
/// Somente leitura para o usuário: quem grava é a sincronização (papel dono). Valores em centavos.
model BankInvestment {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  connectionId         String    @map("connection_id") @db.Uuid
  providerInvestmentId String    @map("provider_investment_id") @db.VarChar(128)
  name                 String    @db.VarChar(200)
  /// Categoria do provedor: FIXED_INCOME, MUTUAL_FUND, EQUITY, ETF, SECURITY, COE, OTHER.
  type                 String    @db.VarChar(30)
  /// CDB, LCI, LCA, TREASURE, ... (como informado pelo banco).
  subtype              String?   @db.VarChar(40)
  issuer               String?   @db.VarChar(200)
  /// ACTIVE, PENDING ou TOTAL_WITHDRAWAL.
  status               String    @default("ACTIVE") @db.VarChar(20)
  /// Valor atual da posição.
  balanceCents         BigInt    @map("balance_cents")
  investedCents        BigInt?   @map("invested_cents")
  /// Rendimento acumulado (pode ser negativo).
  profitCents          BigInt?   @map("profit_cents")
  withdrawableCents    BigInt?   @map("withdrawable_cents")
  /// Indexador (CDI, SELIC, PRE...) e taxas, exatamente como o banco informa.
  rateType             String?   @map("rate_type") @db.VarChar(20)
  rate                 Decimal?  @db.Decimal(12, 4)
  fixedAnnualRate      Decimal?  @map("fixed_annual_rate") @db.Decimal(12, 4)
  annualRate           Decimal?  @map("annual_rate") @db.Decimal(12, 4)
  issueDate            DateTime? @map("issue_date") @db.Date
  dueDate              DateTime? @map("due_date") @db.Date
  /// Última leitura em que este investimento apareceu no provedor.
  lastSeenAt           DateTime  @map("last_seen_at") @db.Timestamptz(6)
  /// Preenchido quando o investimento some do banco ou é resgatado por completo.
  closedAt             DateTime? @map("closed_at") @db.Timestamptz(6)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user       User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection BankConnection           @relation(fields: [userId, connectionId], references: [userId, id], onDelete: NoAction)
  snapshots  BankInvestmentSnapshot[]

  @@unique([connectionId, providerInvestmentId])
  @@unique([userId, id])
  @@index([userId, closedAt])
  @@map("bank_investments")
}

/// Uma foto por dia do valor de cada investimento: é a base do gráfico de evolução.
model BankInvestmentSnapshot {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  investmentId  String   @map("investment_id") @db.Uuid
  snapshotDate  DateTime @map("snapshot_date") @db.Date
  balanceCents  BigInt   @map("balance_cents")
  investedCents BigInt?  @map("invested_cents")
  profitCents   BigInt?  @map("profit_cents")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  investment BankInvestment @relation(fields: [userId, investmentId], references: [userId, id], onDelete: NoAction)

  @@unique([investmentId, snapshotDate])
  @@index([userId, snapshotDate])
  @@map("bank_investment_snapshots")
}

// ───────────────────────────── Notificações ──────────────────────────────────

model Notification {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  title     String           @db.VarChar(120)
  body      String           @db.VarChar(500)
  data      Json?
  /// Evita notificação duplicada (ex.: "budget:<id>:2026-10:80"). Único por usuário.
  dedupeKey String?          @map("dedupe_key") @db.VarChar(120)
  readAt    DateTime?        @map("read_at") @db.Timestamptz(6)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt(sort: Desc)])
  @@map("notifications")
}

model PushToken {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  expoToken  String       @unique @map("expo_token")
  platform   PushPlatform
  deviceName String?      @map("device_name") @db.VarChar(100)
  lastSeenAt DateTime     @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_tokens")
}

// ─────────────────────── LGPD, auditoria e infraestrutura ────────────────────

/// Pedidos de exportação/exclusão. user_id vira NULL quando o usuário é apagado:
/// a prova de atendimento permanece sem dado pessoal.
model PrivacyRequest {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String?              @map("user_id") @db.Uuid
  type            PrivacyRequestType
  status          PrivacyRequestStatus @default(PENDING)
  requestedAt     DateTime             @default(now()) @map("requested_at") @db.Timestamptz(6)
  completedAt     DateTime?            @map("completed_at") @db.Timestamptz(6)
  /// Caminho do arquivo de exportação (storage privado), expira em export_expires_at.
  exportFilePath  String?              @map("export_file_path")
  exportExpiresAt DateTime?            @map("export_expires_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, type])
  @@index([status, requestedAt])
  @@map("privacy_requests")
}

/// Trilha de auditoria (append-only). SEM FK de propósito: sobrevive à exclusão do usuário.
/// Nunca gravar senha, token, valor financeiro ou dado bancário em `metadata`.
model AuditLog {
  id        BigInt   @id @default(autoincrement())
  actorId   String?  @map("actor_id") @db.Uuid
  action    String   @db.VarChar(80)
  entity    String?  @db.VarChar(60)
  entityId  String?  @map("entity_id") @db.VarChar(64)
  ipHash    String?  @map("ip_hash") @db.VarChar(64)
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

/// Webhooks recebidos do provedor (idempotência + diagnóstico). Purgar em ~30 dias.
model WebhookEvent {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider    OpenFinanceProvider
  eventId     String              @map("event_id") @db.VarChar(128)
  eventType   String              @map("event_type") @db.VarChar(80)
  payload     Json
  receivedAt  DateTime            @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt DateTime?           @map("processed_at") @db.Timestamptz(6)
  error       String?             @db.VarChar(500)

  @@unique([provider, eventId])
  @@index([receivedAt])
  @@map("webhook_events")
}

/// Chaves de idempotência de POSTs (fila offline). Purgar após ~48h.
model IdempotencyKey {
  userId    String   @map("user_id") @db.Uuid
  key       String   @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, key])
  @@index([createdAt])
  @@map("idempotency_keys")
}
