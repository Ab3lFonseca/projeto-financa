# Copie para .env (que NÃO é versionado) e preencha. Nunca coloque segredos neste arquivo.
# Estas variáveis são da API e das migrations. Nenhuma vai para o app mobile: ele só conhece a
# URL pública da API (EXPO_PUBLIC_API_URL, que não é segredo).
# Em produção, defina-as como segredos do host (Fly: `fly secrets set`), não em arquivo.

# ─── Servidor ────────────────────────────────────────────────────────────────────
NODE_ENV=development            # development | test | production
PORT=3000
LOG_LEVEL=info                  # fatal | error | warn | info | debug | trace | silent
# Origens permitidas no CORS (só o painel web/Expo web; o app nativo não usa CORS).
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
TRUST_PROXY=true                # atrás do Fly/Cloudflare: confiar em X-Forwarded-For
RATE_LIMIT_MAX=300              # requisições por minuto por IP (rotas sensíveis têm limites próprios)
JOBS_ENABLED=true               # recorrências, lembretes, exclusões de conta, Open Finance
# Arquivos de log (api-AAAA-MM-DD.log e errors-AAAA-MM-DD.log). Em desenvolvimento o padrão já é .data/logs.
# Em produção, vazio = só console (fly logs); para guardar em disco, monte um volume e aponte aqui.
# LOG_DIR=/data/logs
LOG_RETENTION_DAYS=30           # dias de arquivos de log mantidos (veja docs/logs.md)

# ─── Banco de dados (Postgres) ───────────────────────────────────────────────────
# Local (pnpm dev:db) — já vem preenchido:
DATABASE_URL="postgresql://postgres:dev-only-password@127.0.0.1:54329/financa"
# Produção (Supabase): "Session pooler" (porta 5432), região sa-east-1:
# DATABASE_URL="postgresql://postgres.PROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"
DB_POOL_MAX=10
# Conexão DIRETA usada só pelo Prisma Migrate (opcional; sem ela usa DATABASE_URL).
# DIRECT_URL="postgresql://postgres:SENHA@db.PROJETO.supabase.co:5432/postgres"

# ─── Autenticação ────────────────────────────────────────────────────────────────
# "supabase" (produção) ou "dev" (somente local: usuários num arquivo, senha com scrypt; PROIBIDO em produção).
AUTH_MODE=dev
DEV_JWT_SECRET=dev-only-jwt-secret-change-me-1234
# Supabase Auth (obrigatórias em produção):
# SUPABASE_URL=https://PROJETO.supabase.co
# SUPABASE_ANON_KEY=...                 # chave pública (anon/publishable)
# SUPABASE_SERVICE_ROLE_KEY=...         # chave SECRETA: só no servidor; usada para excluir contas (LGPD)
# SUPABASE_JWT_SECRET=...               # só se o projeto ainda usa o segredo HS256 legado
# JWT_AUDIENCE=authenticated
# Deep link aberto pelo e-mail de recuperação de senha (veja docs/deploy.md):
# PASSWORD_RESET_REDIRECT_URL=financa://reset-password

# ─── Privacidade e termos ────────────────────────────────────────────────────────
# Segredo do HMAC dos IPs guardados em auditoria/consentimentos (nunca guardamos IP em claro).
# Gere com: openssl rand -hex 32   (obrigatório trocar em produção)
IP_HASH_PEPPER=dev-only-pepper-change-me
# Mudou o texto dos Termos/Política? Suba a versão e todos precisarão aceitar de novo.
LEGAL_TERMS_VERSION=2026-10-01
LEGAL_PRIVACY_VERSION=2026-10-01

# ─── Link do e-mail de confirmação de cadastro (tela /confirm-email do app) ──────
# Precisam estar em "Redirect URLs" no Supabase. Celular: deep link; web: página do site.
# EMAIL_CONFIRM_REDIRECT_URL=financa://confirm-email
# EMAIL_CONFIRM_WEB_REDIRECT_URL=https://SEU-SITE.onrender.com/confirm-email

# ─── IP do cliente (limites de tentativas) ───────────────────────────────────────
# Atrás de proxy, NÃO confie no X-Forwarded-For (o cliente o forja e ganha um contador novo a cada tentativa).
# Aponte para o cabeçalho que só a borda escreve: Render (Cloudflare) = cf-connecting-ip; Fly.io = fly-client-ip.
# CLIENT_IP_HEADER=cf-connecting-ip

# ─── Planos ──────────────────────────────────────────────────────────────────────
# false = beta (todos têm recursos Premium). true = limites do plano gratuito passam a valer.
BILLING_ENFORCED=false

# ─── Open Finance (Pluggy) — desligado por padrão ────────────────────────────────
# Veja docs/open-finance.md (custos, contrato e passo a passo antes de ligar).
OPEN_FINANCE_ENABLED=false
# pluggy (padrão) ou demo: banco fictício com conta, cartão e investimentos, só para testar sem contratar o Pluggy.
# O modo demo é proibido em produção (a API recusa subir). Para testar: OPEN_FINANCE_ENABLED=true + demo.
# OPEN_FINANCE_PROVIDER=pluggy
# PLUGGY_CLIENT_ID=
# PLUGGY_CLIENT_SECRET=
# Segredo que o Pluggy envia no cabeçalho x-webhook-secret (>= 24 caracteres; openssl rand -hex 32).
# PLUGGY_WEBHOOK_SECRET=
# PLUGGY_BASE_URL=https://api.pluggy.ai
# Deep link para onde o banco devolve o usuário depois de autorizar:
# OPEN_FINANCE_REDIRECT_URI=financa://open-finance
# Idem para o app WEB (local: http://localhost:8081/open-finance; Render: https://SEU-SITE.onrender.com/open-finance):
# OPEN_FINANCE_WEB_REDIRECT_URI=http://localhost:8081/open-finance
# Aceita também o conector gratuito MeuPluggy (teste com a SUA conta; só local — a API recusa subir assim em produção).
# Veja docs/open-finance.md, seção 10.
# PLUGGY_ALLOW_MEUPLUGGY=false
